<Application x:Class="WPF_UartAssist.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WPF_UartAssist.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 调色板（可被 ThemeManager 运行时整体替换） -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- 样式（只加载一次） -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusBrushConverter x:Key="StatusBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:WordWrapConverter x:Key="WordWrapConverter" />
            <conv:ParityToTextConverter x:Key="ParityToTextConverter" />
            <conv:StopBitsToTextConverter x:Key="StopBitsToTextConverter" />
            <conv:HandshakeToTextConverter x:Key="HandshakeToTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
