<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        液态玻璃调色板（Liquid Glass）。

        与 Light/Dark 的关键差别：
        1. 面板色带 Alpha，背景的光斑能透上来，形成「玻璃」层次；
        2. 描边用亮白渐变，模拟玻璃边缘的高光折射；
        3. 圆角更大（PanelCornerRadius = 16），贴近液态玻璃的柔和轮廓。

        键名必须与另外两个字典完全一致，否则切换主题时 DynamicResource 会解析失败。
    -->

    <!-- ============ 调色板 ============ -->
    <Color x:Key="BgColor">#FF05080F</Color>
    <Color x:Key="PanelColor">#8C18233A</Color>
    <Color x:Key="PanelAltColor">#5C1F2C45</Color>
    <Color x:Key="BorderColor">#40FFFFFF</Color>
    <Color x:Key="TextColor">#FFE8F1FF</Color>
    <Color x:Key="TextDimColor">#FF94A6C4</Color>
    <Color x:Key="AccentColor">#FF4FD6FF</Color>
    <Color x:Key="AccentHoverColor">#FF7FE2FF</Color>
    <Color x:Key="OnlineColor">#FF3DFFC0</Color>
    <Color x:Key="OfflineColor">#FF6A7A96</Color>
    <Color x:Key="DangerColor">#FFFF7D8C</Color>
    <Color x:Key="WarnColor">#FFFFC75C</Color>
    <Color x:Key="LogBackgroundColor">#66070C16</Color>
    <Color x:Key="LogForegroundColor">#FFD3E3FB</Color>
    <Color x:Key="ButtonHoverColor">#33FFFFFF</Color>
    <Color x:Key="ButtonPressedColor">#1AFFFFFF</Color>
    <Color x:Key="SelectionBgColor">#554FD6FF</Color>
    <Color x:Key="ScrollThumbColor">#59FFFFFF</Color>
    <Color x:Key="PrimaryTextColor">#FF03121C</Color>
    <Color x:Key="DangerBgColor">#2EFF7D8C</Color>
    <Color x:Key="DangerBorderColor">#5CFF7D8C</Color>

    <!-- 日志分色：深底上提高明度，保证穿透半透明背景后仍清晰 -->
    <Color x:Key="LogReceiveColor">#FF5CF7C4</Color>
    <Color x:Key="LogSendColor">#FF79C6FF</Color>
    <Color x:Key="LogSystemColor">#FF94A6C4</Color>
    <Color x:Key="LogPrefixColor">#FF6A7A96</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />

    <!--
        面板背景不用纯色：上沿偏亮、下部偏深，模拟玻璃片受光后的明暗过渡。
        各段都带 Alpha，背后的光斑仍能透上来。
    -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A62C3E63" Offset="0" />
        <GradientStop Color="#7A151D30" Offset="0.55" />
        <GradientStop Color="#8C0F1626" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource OnlineColor}" />
    <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource OfflineColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{StaticResource LogBackgroundColor}" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource LogForegroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />

    <SolidColorBrush x:Key="LogReceiveBrush" Color="{StaticResource LogReceiveColor}" />
    <SolidColorBrush x:Key="LogSendBrush" Color="{StaticResource LogSendColor}" />
    <SolidColorBrush x:Key="LogSystemBrush" Color="{StaticResource LogSystemColor}" />
    <SolidColorBrush x:Key="LogPrefixBrush" Color="{StaticResource LogPrefixColor}" />

    <!-- ============ 玻璃质感专用 ============ -->
    <!-- 面板描边：上沿亮、下沿暗，模拟玻璃边缘的高光与折射 -->
    <LinearGradientBrush x:Key="PanelBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.45" />
        <GradientStop Color="#0DFFFFFF" Offset="0.75" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="PanelCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

</ResourceDictionary>
